<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.scoreboard.app.controller.AccountSetupController">
   <children>
      <Button layoutX="466.0" layoutY="341.0" mnemonicParsing="false" onAction="#registerAccount" text="Register &amp; Login" />
      <TextField fx:id="accountNameTextField" layoutX="70.0" layoutY="152.0" promptText="Input your accoun name" />
      <Label layoutX="70.0" layoutY="116.0" text="Account Name" />
      <VBox layoutX="70.0" layoutY="193.0" prefHeight="101.0" prefWidth="200.0" spacing="5">
         <children>
            <Label prefHeight="17.0" prefWidth="89.0" text="Secret question" />
            <ChoiceBox fx:id="questionChoiceBox" prefWidth="150.0" />
            <TextField fx:id="secretQuestionTextField" promptText="Answer" />
         </children></VBox>
      <VBox layoutX="340.0" layoutY="116.0" prefHeight="200.0" prefWidth="208.0" spacing="20">
         <children>
            <Label prefHeight="17.0" prefWidth="100.0" text="Password" />
            <TextField fx:id="passwordTextField" promptText="Enter your password" />
            <Label text="Confirm your password" />
            <TextField fx:id="passwordConfirmationTextField" promptText="Enter your password" />
         </children>
      </VBox>
      <Label layoutX="70.0" layoutY="38.0" text="Register new account">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
      <Label fx:id="errorLabel" alignment="CENTER" layoutX="200.0" layoutY="308.0" prefHeight="17.0" prefWidth="200.0" text="Label" textFill="#b70000" visible="false" />
      <Button layoutX="44.0" layoutY="341.0" mnemonicParsing="false" onAction="#backToAccountSelection" text="Back to selection page" />
   </children>
</AnchorPane>
